<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>es.nesi</groupId>
  <artifactId>Excel</artifactId>
  <version>1.0.0</version>
  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <maven.compiler.release>21</maven.compiler.release>
</properties>
  <dependencies>
    <!-- Core de Apache POI para archivos .xls -->
    <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi</artifactId>
        <version>5.5.1</version>
    </dependency>
    
    <!-- Soporte para formatos modernos .xlsx (OOXML) -->
    <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>5.5.1</version>
    </dependency>
    <!-- Jackson Databind: La librería principal para convertir JSON a Objetos -->
    <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>2.17.0</version>
    </dependency>
    
    <!-- Picocli: Para la interfaz de línea de comandos -->
    <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>4.7.5</version>
    </dependency>
	<!-- JUnit 5 (Jupiter) -->
	<dependency>
	    <groupId>org.junit.jupiter</groupId>
	    <artifactId>junit-jupiter</artifactId>
	    <version>5.11.0</version>
	    <scope>test</scope>
	</dependency>
	<!-- Mockito para JUnit 5 -->
	<dependency>
	    <groupId>org.mockito</groupId>
	    <artifactId>mockito-junit-jupiter</artifactId>
	    <version>5.12.0</version>
	    <scope>test</scope>
	</dependency>    
	 <dependency>
	 	<groupId>es.nesi</groupId>
	 	<artifactId>NLog</artifactId>
	 	<version>1.0.0</version>
	 </dependency>
  </dependencies>  
</project>